[Unit]
Description=actuary.it.com Django backend
After=network-online.target
Wants=network-online.target

[Service]
User=actuary
Group=actuary
EnvironmentFile=/etc/actuary-site.env
WorkingDirectory=/opt/actuary/backend
ExecStart=/opt/actuary-venv/bin/gunicorn backend.wsgi:application --bind 127.0.0.1:8001 --workers 2 --timeout 120 --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
