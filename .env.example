# Copy to .env and adjust. .env is never committed.
APP_MODE=personal
SECRET_KEY=change-me-to-a-long-random-string
# Personal data (database, price cache, admin reports) is stored OUTSIDE the project folder, because the
# project lives in OneDrive and would sync accounts and portfolios to the cloud.
# Default: %USERPROFILE%\.portfel-analizi\data   (override all three with PA_DATA_DIR, or one by one below)
# PA_DATA_DIR=C:/Users/you/.portfel-analizi/data
# DATABASE_URL=sqlite:///C:/Users/you/.portfel-analizi/data/app.db
# DATA_CACHE_DIR=C:/Users/you/.portfel-analizi/data/cache
# ADMIN_REPORTS_DIR=C:/Users/you/.portfel-analizi/data/reports
# Future licensed provider
# EODHD_API_KEY=
